# Copy this file to .env and adjust if needed.

PORT=3000

# Storage backend — pick one:
#   memory   -> in-memory array (resets on restart, no DB needed)
#   sqlite   -> SQLite file at tasks.db (survives restarts, no server needed)
#   postgres -> Postgres (requires DATABASE_URL below and a running Postgres)
DB_DRIVER=sqlite

# Only required when DB_DRIVER=postgres:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskdb