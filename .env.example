git add -A && git status# Copy this file to .env and adjust if needed.
# When running via `docker compose up`, "db" is the Postgres service name
# from docker-compose.yml, resolved automatically on the compose network.

PORT=3000

# memory = use the in-memory repository (no Postgres needed)
# postgres = use the Postgres repository (requires DATABASE_URL below)
DB_DRIVER=postgres

DATABASE_URL=postgres://postgres:postgres@db:5432/taskdb
